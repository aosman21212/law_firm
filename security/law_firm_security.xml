<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_law_firm" model="ir.module.category">
        <field name="name">Law Firm</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_law_user" model="res.groups">
        <field name="name">User: Own Cases</field>
        <field name="category_id" ref="module_category_law_firm"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_law_manager" model="res.groups">
        <field name="name">Manager: All Cases</field>
        <field name="category_id" ref="module_category_law_firm"/>
        <field name="implied_ids" eval="[(4, ref('group_law_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Record rules -->
    <record id="rule_law_case_user" model="ir.rule">
        <field name="name">Law Case: own or team cases</field>
        <field name="model_id" ref="model_law_case"/>
        <field name="domain_force">['|', ('lawyer_id', '=', user.id), ('assistant_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_law_user'))]"/>
    </record>

    <record id="rule_law_case_manager" model="ir.rule">
        <field name="name">Law Case: all cases</field>
        <field name="model_id" ref="model_law_case"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_law_manager'))]"/>
    </record>

    <record id="rule_law_case_company" model="ir.rule">
        <field name="name">Law Case: multi-company</field>
        <field name="model_id" ref="model_law_case"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_law_hearing_user" model="ir.rule">
        <field name="name">Hearing: own or team cases</field>
        <field name="model_id" ref="model_law_hearing"/>
        <field name="domain_force">['|', ('case_id.lawyer_id', '=', user.id), ('case_id.assistant_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_law_user'))]"/>
    </record>

    <record id="rule_law_hearing_manager" model="ir.rule">
        <field name="name">Hearing: all</field>
        <field name="model_id" ref="model_law_hearing"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_law_manager'))]"/>
    </record>
</odoo>
