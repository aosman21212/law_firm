<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="law_hearing_view_list" model="ir.ui.view">
        <field name="name">law.hearing.list</field>
        <field name="model">law.hearing</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('done', 'cancelled')" decoration-warning="state == 'postponed'">
                <field name="date_hearing"/>
                <field name="name"/>
                <field name="case_id"/>
                <field name="client_id"/>
                <field name="court_id"/>
                <field name="lawyer_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge" decoration-info="state == 'scheduled'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="law_hearing_view_form" model="ir.ui.view">
        <field name="name">law.hearing.form</field>
        <field name="model">law.hearing</field>
        <field name="arch" type="xml">
            <form string="Hearing">
                <header>
                    <button name="action_done" type="object" string="Mark as Done"
                            class="oe_highlight" invisible="state != 'scheduled'"/>
                    <button name="action_postpone" type="object" string="Postpone"
                            invisible="state != 'scheduled'"/>
                    <button name="action_reschedule" type="object" string="Reschedule"
                            invisible="state not in ('postponed', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="scheduled,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. First hearing"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="case_id"/>
                            <field name="client_id"/>
                            <field name="court_id"/>
                        </group>
                        <group>
                            <field name="date_hearing"/>
                            <field name="duration" widget="float_time"/>
                            <field name="lawyer_id" widget="many2one_avatar_user"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Preparation" name="notes">
                            <field name="notes"/>
                        </page>
                        <page string="Result" name="result">
                            <field name="result" placeholder="What happened in this hearing?"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="law_hearing_view_calendar" model="ir.ui.view">
        <field name="name">law.hearing.calendar</field>
        <field name="model">law.hearing</field>
        <field name="arch" type="xml">
            <calendar string="Hearings" date_start="date_hearing" date_delay="duration"
                      color="lawyer_id" mode="month" quick_create="0" event_open_popup="1">
                <field name="case_id"/>
                <field name="client_id"/>
                <field name="court_id"/>
            </calendar>
        </field>
    </record>

    <record id="law_hearing_view_search" model="ir.ui.view">
        <field name="name">law.hearing.search</field>
        <field name="model">law.hearing</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="case_id"/>
                <field name="client_id"/>
                <field name="court_id"/>
                <filter name="my_hearings" string="My Hearings" domain="[('lawyer_id', '=', uid)]"/>
                <filter name="scheduled" string="Scheduled" domain="[('state', '=', 'scheduled')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_case" string="Case" context="{'group_by': 'case_id'}"/>
                    <filter name="group_court" string="Court" context="{'group_by': 'court_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date_hearing:week'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="law_hearing_action" model="ir.actions.act_window">
        <field name="name">Hearings</field>
        <field name="res_model">law.hearing</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Schedule your first hearing</p>
        </field>
    </record>
</odoo>
